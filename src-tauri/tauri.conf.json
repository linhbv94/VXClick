{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "VXClick",
  "version": "1.0.0",
  "identifier": "com.vxclick.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1424",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; media-src 'self' asset: blob: data:; img-src 'self' asset: blob: data:; connect-src 'self' asset: blob: data:;"
    },
    "windows": [
      {
        "label": "main",
        "title": "VXClick",
        "width": 310,
        "height": 38,
        "minWidth": 310,
        "minHeight": 38,
        "resizable": false,
        "fullscreen": false,
        "alwaysOnTop": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
